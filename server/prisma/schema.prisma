generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles {
  Admin
  User
}

enum State {
  Delete
  Active
  Inactive
  Historic
}

enum OrderStatus {
  Pending
  Preparing
  OnRoute
  AtReferencePoint
  Delivered
  Cancelled
}

model User {
  id        String   @id @default(cuid())
  name      String?
  userName  String   @unique
  password  String
  rol       Roles    @default(User)
  state     State    @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?   @unique
  phone     String?
  googleId  String
  photo     String
  state     State     @default(Active)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  booking[]
}

model booking {
  id                  String            @id @default(cuid())
  clientId            String
  productId           String
  referenceLocationId String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  Client              Client            @relation(fields: [clientId], references: [id])
  Product             Product           @relation(fields: [productId], references: [id])
  ReferenceLocation   ReferenceLocation @relation(fields: [referenceLocationId], references: [id])
}

model Product {
  id          String       @id @default(cuid())
  name        String
  description String?
  urlImage    String?
  star        Float
  price       Float
  state       State        @default(Active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stock       Float
  Propiety    Propiety[]
  categoryId  String
  Category    Category     @relation(fields: [categoryId], references: [id])
  Promutions  Promutions[]
  bookings    booking[]
  quotes      Quote[]
}

model Propiety {
  id        String   @id @default(cuid())
  key       String
  value     String
  state     State    @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Product   Product  @relation(fields: [productId], references: [id])
  productId String
}

model Promutions {
  id          String   @id @default(cuid())
  title       String
  discount    Float?
  description String?
  productId   String
  state       State    @default(Active)
  Product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  state     State     @default(Active)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Product   Product[]
}

model ReferenceLocation {
  id        String    @id @default(cuid())
  address   String
  latitude  Float
  longitude Float
  state     State     @default(Active)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  booking[]
}

model Quote {
  id        String   @id @default(cuid())
  productId String
  total     Float
  ip        String
  origin    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Product   Product  @relation(fields: [productId], references: [id])
}
