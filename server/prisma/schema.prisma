generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  Admin
  User
}

enum State {
  Delete
  Active
  Inactive
  Historic
}

model User {
  id        String   @id @default(cuid())
  name      String?
  userName  String   @unique
  password  String
  rol       Roles    @default(User)
  state     State    @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  state     State    @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String       @id @default(cuid())
  name        String
  description String?
  urlImage    String?
  star        Float
  price       Float
  state       State        @default(Active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Stock       Stock?
  Propiety    Propiety[]
  categoryId  String
  Category    Category     @relation(fields: [categoryId], references: [id])
  Promutions  Promutions[]
}

model Propiety {
  id        String   @id @default(cuid())
  key       String
  value     String
  state     State    @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Product   Product  @relation(fields: [productId], references: [id])
  productId String
}

model Promutions {
  id          String   @id @default(cuid())
  title       String
  discount    Float?
  description String?
  productId   String
  state       State    @default(Active)
  Product     Product  @relation(fields: [productId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReferenceLocation {
  id        String   @id @default(cuid())
  address   String
  latitude  Float
  longitude Float
  state     State    @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stock {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @unique
  quantity  Int
  state     State    @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  state     State     @default(Active)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Product   Product[]
}

